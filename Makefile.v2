# Makefile.vars includes a set of variables and flags that control how the
# Makefile is interpreted.
include Makefile.vars

# This makefile supports being run through a container. If CONTAINER is true,
# then commands will be run through a container instead of locally.
CONTAINER     ?= false
BUILD_IMAGE   ?= grafana/agent-build-image:0.13.0 # Used when CONTAINER==true

ifeq ($(CONTAINER),false)
agent:
	go build $(CGO_FLAGS) -o cmd/agent/agent ./cmd/agent

all:
	echo all

else # CONTAINER == true
# Not all targets can be run in a container. Calling these targets will just
# re-execute the makefile without CONTAINER set.
CONTAINER_UNSUPPORTED = all

$(CONTAINER_UNSUPPORTED):
	@$(MAKE) CONTAINER=false -f $(MAKEFILE_LIST) $@

%:
	# TODO: proxy to container
endif
